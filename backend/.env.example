# PostgreSQL connection for app metadata storage
# Local: postgresql+psycopg://tb_user:your_password@localhost:5432/tb_query_db
# Supabase: postgresql+psycopg://postgres.xxxxx:your_password@aws-0-region.pooler.supabase.com:5432/postgres
DATABASE_URL=postgresql+psycopg://tb_user:your_password@localhost:5432/tb_query_db

# Groq API key for AI-powered SQL generation
GROQ_API_KEY=gsk_your_groq_api_key_here

# Optional: comma-separated list of allowed CORS origins
# CORS_ORIGINS=http://localhost:5173,http://localhost:5174
